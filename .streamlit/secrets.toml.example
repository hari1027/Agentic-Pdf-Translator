# Copy this file to .streamlit/secrets.toml and paste your free key(s).
# NEVER commit secrets.toml to GitHub.
GEMINI_API_KEY = "paste-your-gemini-key-here"

# Optional: automatic backup if Gemini's free limit runs out
GROQ_API_KEY = "paste-your-groq-key-here"

# Optional overrides. Leave these out: by default the app asks each provider which
# models exist right now and picks the best one, switching automatically when a
# model is retired or out of free quota.
# GEMINI_MODEL = "auto"
# GROQ_MODEL = "auto"
# REVIEWER = "false"   # fewer requests for big books
